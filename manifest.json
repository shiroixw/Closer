{
  "manifest_version": 3,
  "name": "Closer — Click any image to view it full size",
  "version": "0.1.0",
  "description": "Click any image to open it full size, in place, with its real dimensions. No tracking, no build step.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Closer",
    "default_popup": "ui/popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
